1. Insert Data in a Transaction
Write a SQL query to insert data into multiple tables within a transaction, rolling back if any part fails.


BEGIN
    --let say a user cashout 500 tk from his bksh account

    UPDATE CUSTOMER_BALANCE
    SET current_balance = current_balance - 500
    WHERE account_no = '01711223344';

    --INSERT IN LOG TABLE
    INSERT INTO TRANSACTION_LOG (trx_id, account_no, amount, trx_type)
    VALUES (5001, '01711223344', 500, 'CASH_OUT');

    -COMMIT;
    DBMS_OUTPUT.PUT_LINE('Transaction Success: Balance updated and Logged.');


EXCEPTION 
    WHEN OTHERS THEN
    ROLLBACK;
    DBMS_OUTPUT.PUT_LINE('Transaction Failed: Rolled back everything.');
  
END;
